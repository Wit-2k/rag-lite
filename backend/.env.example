# rag-lite 配置模板：复制为 backend/.env 后按需修改（.env 已被 .gitignore 忽略，别提交）
#
# 优先级：命令行参数 > 环境变量 > 本文件 > 代码里的默认值。
# 三个模型角色（嵌入 / 重排 / 回答）的「接入点 + 模型 ID + 密钥」都能单独配；
# 密钥留空时自动回落到共享的 OPENROUTER_API_KEY。

# ===== 共享密钥（三个角色没单独配时都用它）=====
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 嵌入（向量化）=====
# 接入点：填 base_url 即可，程序自己接 /embeddings
# EMBED_BASE_URL=https://openrouter.ai/api/v1
# EMBED_MODEL=voyageai/voyage-multimodal-3.5
# EMBED_DIM=2048                     # 支持 256/512/1024/2048；⚠ 写进向量库 schema，改了必须重建库
# EMBED_API_KEY=

# ===== 重排 =====
# 接入点：同样填 base_url，程序自己接 /rerank
# RERANK_BASE_URL=https://openrouter.ai/api/v1
# RERANK_MODEL=voyageai/rerank-3
# RERANK_API_KEY=

# ===== 回答（任意 OpenAI Compatible 端点）=====
# CHAT_BASE_URL=https://openrouter.ai/api/v1
# CHAT_MODEL=google/gemini-2.5-flash
# CHAT_API_KEY=

# ===== 检索参数 =====
# RETRIEVE_TOP_K=20                  # 先用余弦召回多少条
# CONTEXT_N=3                        # 重排后送给大模型几条

# ===== 服务 =====
# RAGLITE_HOST=127.0.0.1
# RAGLITE_PORT=17650
# RAGLITE_DB_URI=./data/lancedb      # 换库位置（换嵌入模型重建库时用得上）
