<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="frontend.App"
             xmlns:local="using:frontend"
             RequestedThemeVariant="Default">
             <!-- "Default" 跟随系统主题；也可改成 "Dark" / "Light" -->

    <Application.Resources>
        <!-- 本项目自己的调色板。**刻意不用主题资源键**：一是避免上一轮那种「键名不存在 → 静默失效」，
             二是这套浅色/奶白是固定取向，不必跟随系统深浅色主题变来变去。 -->
        <SolidColorBrush x:Key="RagWhite">#FFFFFFFF</SolidColorBrush>       <!-- 纯白：窗口与对话区 -->
        <SolidColorBrush x:Key="RagSurface">#FFFAFAFA</SolidColorBrush>     <!-- 极浅灰：侧栏、卡片内的小块 -->
        <SolidColorBrush x:Key="RagHairline">#FFE8E8E8</SolidColorBrush>    <!-- 浅灰描边：卡片、分隔线 -->
        <SolidColorBrush x:Key="RagCream">#FFFFFDF6</SolidColorBrush>       <!-- 奶白：按钮底 -->
        <SolidColorBrush x:Key="RagCreamHover">#FFFFF8E8</SolidColorBrush>  <!-- 奶白·悬停 -->
        <SolidColorBrush x:Key="RagCreamPressed">#FFFBF0D8</SolidColorBrush><!-- 奶白·按下 -->
        <SolidColorBrush x:Key="RagButtonBorder">#FFE0E0E0</SolidColorBrush><!-- 按钮的浅灰边框 -->
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <!-- 资源键命名注意（2026-10 逐个在主题字典里核对过）：
             Avalonia 12 的 Fluent 主题用的是 SystemControl* 那一代命名，**没有** WinUI3 的
             TextFillColor* / Card* / Layer* / DividerStroke* / SolidBackgroundFillColor* /
             ApplicationPageBackgroundThemeBrush（AccentButton* 倒是有）。
             更要紧的是：DynamicResource 找不到键时 Avalonia **不抛异常、不写日志**，只是属性不生效——
             「能跑起来」不等于「样式生效」。对照关系：
               TextFillColorPrimary/Secondary/TertiaryBrush -> SystemControlForegroundBaseHigh/BaseMedium/BaseMediumLowBrush
               CardBackgroundFillColorDefaultBrush          -> SystemControlBackgroundChromeMediumLowBrush
               CardStrokeColorDefaultBrush / DividerStroke  -> SystemControlForegroundBaseLowBrush
               LayerFillColorDefaultBrush                   -> SystemControlBackgroundListLowBrush
               SolidBackgroundFillColorBaseBrush            -> SystemControlBackgroundAltHighBrush
               ApplicationPageBackgroundThemeBrush / LayerOnMica... -> SystemControlPageBackgroundChromeLowBrush
        -->
        <FluentTheme />
        <!-- Markdown.Avalonia 的排版样式由控件自己按 MarkdownStyleName 加载（默认 FluentTheme），
             这里不用再 StyleInclude；若以后要换风格，可显式引入
             avares://Markdown.Avalonia/StyleCollections/MarkdownStyle*.axaml。
             版本注意：必须用 12.0.0-a3 及以上——11.0.3 是按 Avalonia 11 编译的，在 Avalonia 12 下会抛
             MissingMethodException（DynamicResourceExtension.ProvideValue），实测踩过。 -->

        <!-- 全局字体栈：优先使用 Windows 11 Fluent 字体，搭配微软雅黑，保障中英文字体清晰优雅 -->
        <Style Selector=":is(TopLevel)">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI, -apple-system, sans-serif" />
        </Style>

        <!-- 所有按钮默认底色：奶白 + 浅灰边框（强调色按钮在后面单独覆盖，顺序不能反） -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource RagCream}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RagButtonBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RagCreamHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RagButtonBorder}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RagCreamPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RagButtonBorder}" />
        </Style>

        <!-- Accent 主操作按钮样式（强调色，保持与系统强调色协调） -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPointerOver}" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressed}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPressed}" />
        </Style>

        <!-- 卡片式容器基础样式，营造 Windows Fluent 层次感 -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Application.Styles>
</Application>
