<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="frontend.App"
             xmlns:local="using:frontend"
             RequestedThemeVariant="Light">
             <!-- 固定浅色：下面的 Rag* 奶白/白色调色板是按浅色设计的，跟随系统深色会读不清 -->

    <Application.Resources>
        <!-- 本项目自己的调色板。**刻意不用主题资源键**：一是避免上一轮那种「键名不存在 → 静默失效」，
             二是这套浅色/奶白是固定取向，不必跟随系统深浅色主题变来变去。 -->
        <SolidColorBrush x:Key="RagWhite">#FFFFFFFF</SolidColorBrush>       <!-- 纯白：窗口与对话区 -->
        <SolidColorBrush x:Key="RagSurface">#FFFAFAFA</SolidColorBrush>     <!-- 极浅灰：侧栏、卡片内的小块 -->
        <SolidColorBrush x:Key="RagHairline">#FFE8E8E8</SolidColorBrush>    <!-- 浅灰描边：卡片、分隔线 -->
        <SolidColorBrush x:Key="RagCream">#FFFFFDF6</SolidColorBrush>       <!-- 奶白：按钮底 -->
        <SolidColorBrush x:Key="RagCreamHover">#FFFFF8E8</SolidColorBrush>  <!-- 奶白·悬停 -->
        <SolidColorBrush x:Key="RagCreamPressed">#FFFBF0D8</SolidColorBrush><!-- 奶白·按下 -->
        <SolidColorBrush x:Key="RagButtonBorder">#FFE0E0E0</SolidColorBrush><!-- 按钮的浅灰边框 -->
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <!-- FluentAvaloniaTheme 提供 WinUI Fluent v2 的样式与资源。
             官方 Getting Started 明确要求：不要再同时加入 Avalonia 的 FluentTheme / SimpleTheme，
             否则两套样式会互相覆盖、出现视觉异常。
             资源键也跟着换成 Fluent v2 命名（TextFillColor* / Card* / AccentFillColor*）；
             旧 FluentTheme 的 SystemControl* 键在这里没有定义，DynamicResource 找不到时不会报错、只会静默失效。 -->
        <sty:FluentAvaloniaTheme PreferSystemTheme="False" PreferUserAccentColor="True" />
        <!-- Markdown.Avalonia 的排版样式由控件自己按 MarkdownStyleName 加载（默认它自带的 Fluent 风格），
             这里不用再 StyleInclude；若以后要换风格，可显式引入
             avares://Markdown.Avalonia/StyleCollections/MarkdownStyle*.axaml。
             版本注意：固定 12.0.2——11.x 是按 Avalonia 11 编译的，在 Avalonia 12 下会抛
             MissingMethodException（DynamicResourceExtension.ProvideValue），实测踩过。 -->

        <!-- 全局字体栈：优先使用 Windows 11 Fluent 字体，搭配微软雅黑，保障中英文字体清晰优雅 -->
        <Style Selector=":is(TopLevel)">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI, -apple-system, sans-serif" />
        </Style>

        <!-- 所有按钮默认底色：奶白 + 浅灰边框（强调色按钮在后面单独覆盖，顺序不能反） -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource RagCream}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RagButtonBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RagCreamHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RagButtonBorder}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RagCreamPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RagButtonBorder}" />
        </Style>

        <!-- Accent 主操作按钮样式（强调色，保持与系统强调色协调） -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorOnAccentDefaultBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>

        <!-- 卡片式容器基础样式，营造 Windows Fluent 层次感 -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Application.Styles>
</Application>
