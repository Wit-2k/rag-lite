<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:frontend.ViewModels"
        xmlns:models="using:frontend.Models"
        xmlns:md="clr-namespace:Markdown.Avalonia.Full;assembly=Markdown.Avalonia.Full"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="frontend.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/book.ico"
        Title="rag-lite — 本地文档问答"
        Width="1180" Height="760" MinWidth="900" MinHeight="600"
        TransparencyLevelHint="Mica,AcrylicBlur"
        Background="{DynamicResource RagWhite}">

    <!-- 主布局：左侧资源管理器/侧边栏风格，右侧工作台对话区 -->
    <!-- 列宽：数据源 320 | 分隔 | 会话 408（原 240 的 1.7 倍）| 分隔 | 对话 -->
    <Grid ColumnDefinitions="320,1,408,1,*">

        <!-- 左边栏：数据源侧边栏，采用 Fluent Navigation/Sidebar 色彩层次 -->
        <Border Grid.Column="0"
                Background="{DynamicResource RagSurface}"
                Padding="16,14">
            <DockPanel>
                <!-- 顶部操作区 -->
                <StackPanel DockPanel.Dock="Top" Spacing="10">
                    <TextBlock Text="数据源" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="批量添加目录…"
                                Classes="accent"
                                Command="{Binding AddSourceCommand}"
                                ToolTip.Tip="可一次选多个 MinerU 产物目录；后端同时最多导入 3 个，其余排队" />
                        <Button Content="刷新"
                                Command="{Binding RefreshCommand}" />
                    </StackPanel>

                    <!-- 后端准备与状态提示 -->
                    <Border Background="{DynamicResource RagWhite}"
                            BorderBrush="{DynamicResource RagHairline}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6"
                            IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding Status}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <!-- 数据源列表：Fluent 卡片列表风格 -->
                <ListBox ItemsSource="{Binding Sources}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,12,0,0">
                    <ListBox.Styles>
                        <!-- 调整每项内边距与选中交互 -->
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.Styles>

                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SourceItemViewModel">
                            <!-- 独立卡片外观 -->
                            <Border Background="{DynamicResource RagWhite}"
                                    BorderBrush="{DynamicResource RagHairline}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />

                                    <!-- 警告标记：如目录丢失或维度不一致 -->
                                    <Border Background="#1FF59E0B"
                                            BorderBrush="#60F59E0B"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            HorizontalAlignment="Left"
                                            IsVisible="{Binding HasBadge}">
                                        <TextBlock Text="{Binding Badge}"
                                                   FontSize="11"
                                                   Foreground="#D97706"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <!-- 导入进度条 -->
                                    <ProgressBar Value="{Binding Progress}"
                                                 Minimum="0" Maximum="100"
                                                 Height="4"
                                                 CornerRadius="2"
                                                 IsIndeterminate="False"
                                                 IsVisible="{Binding IsImporting}" />

                                    <TextBlock Text="{Binding Status}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasStatus}" />

                                    <!-- 移除按钮：轻量级次要按钮 -->
                                    <Button Content="移除"
                                            HorizontalAlignment="Left"
                                            FontSize="12"
                                            Padding="10,3"
                                            Margin="0,2,0,0"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveSourceCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 会话栏：紧挨在「数据源」右边（新建 / 切换 / 重命名 / 删除） -->
        <Border Grid.Column="2"
                Background="{DynamicResource RagWhite}"
                Padding="14,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="10">
                    <TextBlock Text="会话" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    <Button Content="新建会话"
                            Classes="accent"
                            HorizontalAlignment="Stretch"
                            Command="{Binding NewSessionCommand}"
                            ToolTip.Tip="新开一轮对话；标题会按第一个问题自动生成" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Sessions}"
                         SelectedItem="{Binding CurrentSession}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,12,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionItemViewModel">
                            <Border Background="{DynamicResource RagSurface}"
                                    BorderBrush="{DynamicResource RagHairline}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <!-- 标题：平时是文字，重命名时换成输入框 -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding Title}"
                                               IsVisible="{Binding !IsRenaming}"
                                               TextTrimming="CharacterEllipsis"
                                               DoubleTapped="OnSessionTitleDoubleTapped"
                                               ToolTip.Tip="{Binding Title}"
                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                    <TextBox Grid.Row="0" Grid.Column="0"
                                             Text="{Binding Title}"
                                             IsVisible="{Binding IsRenaming}"
                                             AttachedToVisualTree="OnRenameBoxAttached"
                                             KeyDown="OnRenameKeyDown"
                                             Tag="{Binding}"
                                             FontSize="13" />

                                    <!-- 行尾操作：左上「✎」进重命名，删除第一次点是确认 -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Center">
                                        <Button Content="✎" FontSize="12" Padding="6,2"
                                                IsVisible="{Binding !IsRenaming}"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).BeginRenameCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="重命名（也可以双击标题）" />
                                        <Button Content="×" FontSize="12" Padding="6,2"
                                                IsVisible="{Binding !IsConfirmingDelete}"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteSessionCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="删除会话（连同聊天记录）" />
                                        <Button Content="确定删除"
                                                IsVisible="{Binding IsConfirmingDelete}"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteSessionCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="取消"
                                                IsVisible="{Binding IsConfirmingDelete}"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CancelDeleteCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding Subtitle}"
                                               FontSize="11"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 左右分栏分割线：使用系统边框画刷，与 Mica 融合更自然 -->
        <Border Grid.Column="1"
                Background="{DynamicResource RagHairline}" />

        <!-- 会话栏与对话区之间的分隔线 -->
        <Border Grid.Column="3"
                Background="{DynamicResource RagHairline}" />

        <!-- 右边栏：问答对话工作台 -->
        <Border Grid.Column="4"
                Background="{DynamicResource RagWhite}"
                Padding="16,14">
            <DockPanel>
                <!-- 对话顶部标题与快捷操作栏 -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="对话"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <TextBlock Text="{Binding ConfigHint}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding ConfigHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="设置" Command="{Binding OpenSettingsCommand}" />
                        <Button Content="清空上下文" Command="{Binding ClearContextCommand}" />
                        <Button Content="停止"
                                Command="{Binding CancelCommand}"
                                IsEnabled="{Binding IsAsking}"
                                IsVisible="{Binding IsAsking}" />
                    </StackPanel>
                </Grid>

                <!-- 底部输入栏：Windows 现代卡片输入条 -->
                <Border DockPanel.Dock="Bottom"
                        Margin="0,12,0,0"
                        Background="{DynamicResource RagWhite}"
                        BorderBrush="{DynamicResource RagHairline}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="QuestionBox"
                                 Text="{Binding Question}"
                                 PlaceholderText="输入问题…（回车发送）"
                                 AcceptsReturn="False"
                                 KeyDown="OnQuestionKeyDown"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalAlignment="Center"
                                 Padding="10,8" />
                        <Button Grid.Column="1"
                                Content="发送"
                                Classes="accent"
                                Command="{Binding SendCommand}"
                                IsEnabled="{Binding IsReady}"
                                Padding="16,8"
                                Margin="4,0,2,0" />
                    </Grid>
                </Border>

                <!-- 消息滚动列表：区分用户与助手气泡 -->
                <ScrollViewer x:Name="ChatScroll">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MessageViewModel">
                                <StackPanel Margin="0,6">
                                    <!-- 用户气泡：靠右放置，采用强调色卡片与高对比文字 -->
                                    <Border HorizontalAlignment="Right"
                                            MaxWidth="780"
                                            CornerRadius="8,8,2,8"
                                            Padding="14,10"
                                            Background="{DynamicResource AccentButtonBackground}"
                                            BorderBrush="{DynamicResource AccentButtonBorderBrush}"
                                            BorderThickness="1"
                                            IsVisible="{Binding IsUser}">
                                        <SelectableTextBlock Text="{Binding Content}"
                                                             Foreground="{DynamicResource AccentButtonForeground}"
                                                             TextWrapping="Wrap"
                                                             FontSize="13.5" />
                                    </Border>

                                    <!-- 助手气泡：靠左放置，采用 Windows Fluent 标准卡片与边框 -->
                                    <Border HorizontalAlignment="Left"
                                            MaxWidth="860"
                                            CornerRadius="8,8,8,2"
                                            Padding="16,12"
                                            Background="{DynamicResource RagWhite}"
                                            BorderBrush="{DynamicResource RagHairline}"
                                            BorderThickness="1"
                                            IsVisible="{Binding IsAssistant}">
                                        <StackPanel Spacing="8">
                                            <!-- 参考片段标注小字 -->
                                            <Border Background="{DynamicResource RagSurface}"
                                                    BorderBrush="{DynamicResource RagHairline}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Left"
                                                    IsVisible="{Binding HasSources}">
                                                <TextBlock Text="{Binding SourcesText}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                           TextWrapping="Wrap" />
                                            </Border>

                                            <!-- Markdown 渲染输出（列表、公式、代码高亮） -->
                                            <md:MarkdownScrollViewer Markdown="{Binding Content}" />

                                            <!-- 耗时与 Token 元信息 -->
                                            <TextBlock Text="{Binding Meta}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                                       IsVisible="{Binding HasMeta}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
