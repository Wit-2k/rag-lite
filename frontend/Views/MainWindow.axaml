<!-- 默认窗口外框 1920×1200 物理像素；这里的 1280×800 是 150% 缩放下的 DIP 近似，启动时由 OnOpened 精确换算 -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:frontend.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:models="using:frontend.Models"
        xmlns:md="clr-namespace:Markdown.Avalonia.Full;assembly=Markdown.Avalonia.Full"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="frontend.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/book.ico"
        Title="rag-lite — 本地文档问答"
        Width="1280" Height="800" MinWidth="1050" MinHeight="600"
        TransparencyLevelHint="Mica,AcrylicBlur"
        Background="{DynamicResource RagWhite}">

    <!-- 主布局：左侧资源管理器/侧边栏风格，右侧工作台对话区 -->
    <!-- 列宽：数据源 320 | 分隔 | 会话 408（原 240 的 1.7 倍）| 分隔 | 对话 -->
    <Grid ColumnDefinitions="320,1,408,1,*">

        <!-- 左边栏：数据源侧边栏，采用 Fluent Navigation/Sidebar 色彩层次 -->
        <Border Grid.Column="0"
                Background="{DynamicResource RagSurface}"
                Padding="16,14">
            <DockPanel>
                <!-- 顶部操作区 -->
                <StackPanel DockPanel.Dock="Top" Spacing="10">
                    <TextBlock Text="数据源" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="批量添加目录…"
                                Classes="accent"
                                Command="{Binding AddSourceCommand}"
                                ToolTip.Tip="可一次选多个 MinerU 产物目录或纯图片目录；后端同时最多导入 3 个，其余排队" />
                        <Button Content="刷新"
                                Command="{Binding RefreshCommand}" />
                    </StackPanel>

                    <!-- 分组筛选：只影响左栏显示什么，不影响会话的检索范围 -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="分组" FontSize="12" VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding GroupFilters}"
                                  SelectedItem="{Binding SelectedGroupFilter}"
                                  DisplayMemberBinding="{Binding Name}"
                                  FontSize="12"
                                  HorizontalAlignment="Stretch"
                                  ToolTip.Tip="只显示某个分组的数据源（仅影响这个列表）" />
                        <Button Grid.Column="2" Content="管理" FontSize="12"
                                MinHeight="32" Padding="10,0" Margin="6,0,0,0"
                                Command="{Binding ManageGroupsCommand}"
                                ToolTip.Tip="新建 / 改名 / 删除分组，或在组内添加 / 移出数据源" />
                    </Grid>

                    <!-- 后端准备与状态提示 -->
                    <Border Background="{DynamicResource RagWhite}"
                            BorderBrush="{DynamicResource RagHairline}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6"
                            IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding Status}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <!-- 数据源列表：Fluent 卡片列表风格（外面套一层 Grid 是为了放「筛选后为空」的提示） -->
                <Grid Margin="0,12,0,0">
                <TextBlock Text="{Binding SourceFilterHint}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           IsVisible="{Binding SourceFilterHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <ListBox ItemsSource="{Binding SourcesView}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.Styles>
                        <!-- 调整每项内边距与选中交互 -->
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.Styles>

                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SourceItemViewModel">
                            <!-- 独立卡片外观 -->
                            <Border Background="{DynamicResource RagWhite}"
                                    BorderBrush="{DynamicResource RagHairline}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                                    <!-- 所属分组（一个源可以同时在多个分组里） -->
                                    <TextBlock Text="{Binding GroupSummary}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                    <!-- 警告标记：如目录丢失或维度不一致 -->
                                    <Border Background="#1FF59E0B"
                                            BorderBrush="#60F59E0B"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            HorizontalAlignment="Left"
                                            IsVisible="{Binding HasBadge}">
                                        <TextBlock Text="{Binding Badge}"
                                                   FontSize="11"
                                                   Foreground="#D97706"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <!-- 导入进度条 -->
                                    <ProgressBar Value="{Binding Progress}"
                                                 Minimum="0" Maximum="100"
                                                 Height="4"
                                                 CornerRadius="2"
                                                 IsIndeterminate="False"
                                                 IsVisible="{Binding IsImporting}" />

                                    <TextBlock Text="{Binding Status}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasStatus}" />

                                    <!-- 分组关系统一在「管理」窗口里维护；卡片只保留只读摘要和移除按钮 -->
                                    <Button Content="移除"
                                            HorizontalAlignment="Left"
                                            FontSize="12"
                                            Padding="10,3"
                                            Margin="0,2,0,0"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveSourceCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 会话栏：紧挨在「数据源」右边（新建 / 切换 / 重命名 / 删除） -->
        <Border Grid.Column="2"
                Background="{DynamicResource RagWhite}"
                Padding="14,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="10">
                    <TextBlock Text="会话" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Button Content="新建会话"
                            Classes="accent"
                            HorizontalAlignment="Stretch"
                            Command="{Binding NewSessionCommand}"
                            ToolTip.Tip="新开一轮对话；标题会按第一个问题自动生成" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Sessions}"
                         SelectedItem="{Binding CurrentSession}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,12,0,0">
                    <ListBox.Styles>
                        <!-- 卡片只做一层：ListBoxItem 自己就是会话卡片，模板里不再套 Border -->
                        <Style Selector="ListBoxItem">
                            <Setter Property="Background" Value="{DynamicResource RagSurface}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource RagHairline}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionItemViewModel">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <!-- 标题：平时是文字，重命名时换成输入框 -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Title}"
                                           IsVisible="{Binding !IsRenaming}"
                                           TextTrimming="CharacterEllipsis"
                                           DoubleTapped="OnSessionTitleDoubleTapped"
                                           ToolTip.Tip="{Binding Title}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBox Grid.Row="0" Grid.Column="0"
                                         Text="{Binding Title}"
                                         IsVisible="{Binding IsRenaming}"
                                         AttachedToVisualTree="OnRenameBoxAttached"
                                         KeyDown="OnRenameKeyDown"
                                         LostFocus="OnRenameBoxLostFocus"
                                         Tag="{Binding}"
                                         FontSize="13" />

                                <!-- 行尾操作：左上「✎」进重命名，删除第一次点是确认 -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                            VerticalAlignment="Center">
                                    <Button Content="✎" FontSize="12" Padding="6,2"
                                            IsVisible="{Binding !IsRenaming}"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).BeginRenameCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="重命名（也可以双击标题）" />
                                    <Button Content="×" FontSize="12" Padding="6,2"
                                            IsVisible="{Binding !IsConfirmingDelete}"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteSessionCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="删除会话（连同聊天记录）" />
                                    <Button Content="确定删除"
                                            IsVisible="{Binding IsConfirmingDelete}"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteSessionCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="取消"
                                            IsVisible="{Binding IsConfirmingDelete}"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CancelDeleteCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Subtitle}"
                                           FontSize="11"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 左右分栏分割线：使用系统边框画刷，与 Mica 融合更自然 -->
        <Border Grid.Column="1"
                Background="{DynamicResource RagHairline}" />

        <!-- 会话栏与对话区之间的分隔线 -->
        <Border Grid.Column="3"
                Background="{DynamicResource RagHairline}" />

        <!-- 右边栏：问答对话工作台 -->
        <Border Grid.Column="4"
                Background="{DynamicResource RagWhite}"
                Padding="16,14">
            <DockPanel>
                <!-- 对话顶部标题与快捷操作栏 -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="对话"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <!-- 当前会话的检索范围：换它只影响之后的问题 -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                            <TextBlock Text="检索范围" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding ScopeOptions}"
                                      SelectedItem="{Binding SelectedScope}"
                                      DisplayMemberBinding="{Binding Name}"
                                      FontSize="12"
                                      MinWidth="160"
                                      IsEnabled="{Binding !IsAsking}"
                                      ToolTip.Tip="这个会话提问时检索哪些数据源；换范围只影响之后的问题" />
                            <TextBlock Text="{Binding ScopeWarning}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       MaxWidth="180"
                                       TextWrapping="Wrap"
                                       Foreground="#D97706"
                                       IsVisible="{Binding ScopeWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="设置" Command="{Binding OpenSettingsCommand}" />
                        <Button Content="清空上下文" Command="{Binding ClearContextCommand}" />
                        <Button Content="停止"
                                Command="{Binding CancelCommand}"
                                IsEnabled="{Binding IsAsking}"
                                IsVisible="{Binding IsAsking}" />
                    </StackPanel>
                </Grid>

                <!-- 配置提示放在标题栏下方独立一行，避免被右侧按钮挤成多行 -->
                <ui:FAInfoBar DockPanel.Dock="Top"
                              Message="{Binding ConfigHint}"
                              Severity="{Binding ConfigSeverity}"
                              IsOpen="{Binding ConfigHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                              IsClosable="False"
                              Margin="0,0,0,12" />

                <!-- 底部输入栏：Windows 现代卡片输入条 -->
                <Border DockPanel.Dock="Bottom"
                        Margin="0,12,0,0"
                        Background="{DynamicResource RagWhite}"
                        BorderBrush="{DynamicResource RagHairline}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="4">
                    <StackPanel Spacing="6">
                        <!-- 以图搜图的查询图预览 -->
                        <Border IsVisible="{Binding HasSelectedImage}"
                                Background="{DynamicResource RagSurface}"
                                BorderBrush="{DynamicResource RagHairline}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6"
                                Margin="4,4,4,0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Image Source="{Binding SelectedImagePreview}"
                                       Width="64" Height="48"
                                       Stretch="UniformToFill" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedImageName}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="8,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Button Grid.Column="2"
                                        Content="移除"
                                        FontSize="12"
                                        Padding="10,4"
                                        Command="{Binding RemoveImageCommand}" />
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox x:Name="QuestionBox"
                                     Text="{Binding Question}"
                                     PlaceholderText="输入问题…（回车发送）"
                                     AcceptsReturn="False"
                                     KeyDown="OnQuestionKeyDown"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalAlignment="Center"
                                     Padding="10,8" />
                            <Button Grid.Column="1"
                                    Content="添加图片"
                                    Command="{Binding AddImageCommand}"
                                    IsEnabled="{Binding !IsAsking}"
                                    Padding="12,8"
                                    Margin="4,0"
                                    ToolTip.Tip="选择 PNG / JPEG 图片进行以图搜图" />
                            <Button Grid.Column="2"
                                    Content="发送"
                                    Classes="accent"
                                    Command="{Binding SendCommand}"
                                    IsEnabled="{Binding IsReady}"
                                    Padding="16,8"
                                    Margin="4,0,2,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 消息滚动列表：区分用户与助手气泡 -->
                <ScrollViewer x:Name="ChatScroll">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MessageViewModel">
                                <StackPanel Margin="0,6">
                                    <!-- 用户气泡：靠右放置，采用强调色卡片与高对比文字 -->
                                    <Border HorizontalAlignment="Right"
                                            MaxWidth="780"
                                            CornerRadius="8,8,2,8"
                                            Padding="14,10"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorOnAccentDefaultBrush}"
                                            BorderThickness="1"
                                            IsVisible="{Binding IsUser}">
                                        <SelectableTextBlock Text="{Binding Content}"
                                                             Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                             TextWrapping="Wrap"
                                                             FontSize="13.5" />
                                    </Border>

                                    <!-- 助手气泡：靠左放置，采用 Windows Fluent 标准卡片与边框 -->
                                    <Border HorizontalAlignment="Left"
                                            MaxWidth="860"
                                            CornerRadius="8,8,8,2"
                                            Padding="16,12"
                                            Background="{DynamicResource RagWhite}"
                                            BorderBrush="{DynamicResource RagHairline}"
                                            BorderThickness="1"
                                            IsVisible="{Binding IsAssistant}">
                                        <StackPanel Spacing="8">
                                            <!-- 参考片段标注小字 -->
                                            <Border Background="{DynamicResource RagSurface}"
                                                    BorderBrush="{DynamicResource RagHairline}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Left"
                                                    IsVisible="{Binding HasSources}">
                                                <TextBlock Text="{Binding SourcesText}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </Border>

                                            <!-- 以图搜图的标题（纯文本；有图片结果时不走 Markdown） -->
                                            <TextBlock Text="{Binding Content}"
                                                       FontSize="13.5"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding HasImageResults}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                            <!-- 以图搜图：命中的图片缩略图 -->
                                            <ItemsControl ItemsSource="{Binding ImageResults}"
                                                          IsVisible="{Binding HasImageResults}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ImageSearchResultViewModel">
                                                        <Border Width="180"
                                                                Margin="0,0,8,8"
                                                                Padding="6"
                                                                Background="{DynamicResource RagSurface}"
                                                                BorderBrush="{DynamicResource RagHairline}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                ToolTip.Tip="{Binding Heading}">
                                                            <StackPanel Spacing="4">
                                                                <Image Source="{Binding Image}"
                                                                       Width="164" Height="120"
                                                                       Stretch="UniformToFill" />
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                <TextBlock Text="{Binding ScoreText}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Markdown 渲染输出（列表、公式、代码高亮） -->
                                            <md:MarkdownScrollViewer Markdown="{Binding Content}"
                                                                     IsVisible="{Binding !HasImageResults}" />

                                            <!-- 耗时与 Token 元信息 -->
                                            <TextBlock Text="{Binding Meta}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       IsVisible="{Binding HasMeta}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
