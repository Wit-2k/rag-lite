<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:frontend.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="700"
        x:Class="frontend.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="设置" Width="620" Height="700"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="16">
        <!-- 底部按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,12,0,0">
            <TextBlock Text="{Binding Error}" Foreground="#DC2626" TextWrapping="Wrap"
                       MaxWidth="360" VerticalAlignment="Center" IsVisible="{Binding HasError}" />
            <Button Content="取消" Click="OnCancel" />
            <Button Content="保存并生效" Click="OnSave" />
        </StackPanel>

        <ScrollViewer>
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding Location}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />

                <TextBlock Text="留空的输入框表示「不修改」——密钥框因此可以只填新值。" FontSize="12" Opacity="0.7" />

                <TextBlock Text="共享密钥（三个角色没单独配时都用它）" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBox Text="{Binding ApiKey}" PasswordChar="●" />
                <TextBlock Text="{Binding ApiKeyHint}" FontSize="12" Opacity="0.7" />

                <TextBlock Text="嵌入（决定向量维度，换了要重建库）" FontWeight="SemiBold" Margin="0,6,0,0" />
                <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto" >
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="接入点" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EmbedBaseUrl}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="模型 ID" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EmbedModel}" Margin="0,2" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="维度" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,2">
                        <ComboBox ItemsSource="{Binding AllowedDims}" SelectedItem="{Binding EmbedDim}" Width="140" />
                        <TextBlock Text="⚠ 与向量库现有维度不一致时会被拒绝（换模型要重建库）"
                                   FontSize="12" Foreground="#D97706" VerticalAlignment="Center"
                                   IsVisible="{Binding DimChanged}" />
                    </StackPanel>
                </Grid>
                <TextBox Text="{Binding EmbedApiKey}" PasswordChar="●" PlaceholderText="嵌入专用密钥" />
                <TextBlock Text="{Binding EmbedApiKeyHint}" FontSize="12" Opacity="0.7" />

                <TextBlock Text="重排" FontWeight="SemiBold" Margin="0,6,0,0" />
                <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="接入点" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RerankBaseUrl}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="模型 ID" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RerankModel}" Margin="0,2" />
                </Grid>
                <TextBox Text="{Binding RerankApiKey}" PasswordChar="●" PlaceholderText="重排专用密钥" />
                <TextBlock Text="{Binding RerankApiKeyHint}" FontSize="12" Opacity="0.7" />

                <TextBlock Text="回答（任意 OpenAI 兼容端点）" FontWeight="SemiBold" Margin="0,6,0,0" />
                <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="接入点" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ChatBaseUrl}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="模型 ID" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ChatModel}" Margin="0,2" />
                </Grid>
                <TextBox Text="{Binding ChatApiKey}" PasswordChar="●" PlaceholderText="回答专用密钥" />
                <TextBlock Text="{Binding ChatApiKeyHint}" FontSize="12" Opacity="0.7" />

                <TextBlock Text="检索" FontWeight="SemiBold" Margin="0,6,0,0" />
                <Grid ColumnDefinitions="80,140,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="召回条数" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RetrieveTopK}" Margin="0,2" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="先用余弦捞多少条" FontSize="12" Opacity="0.7"
                               VerticalAlignment="Center" Margin="8,0" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="上下文条数" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ContextN}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="重排后送给大模型几条（不能超过召回条数）"
                               FontSize="12" Opacity="0.7" VerticalAlignment="Center" Margin="8,0" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
