<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:frontend.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="720"
        x:Class="frontend.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="设置" Width="640" Height="720"
        Icon="/Assets/book.ico"
        WindowStartupLocation="CenterOwner"
        TransparencyLevelHint="Mica,AcrylicBlur"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">

    <DockPanel Margin="18">
        <!-- 底部操作按钮栏：对齐右侧，带有卡片分割感 -->
        <Border DockPanel.Dock="Bottom"
                Margin="0,14,0,0"
                Padding="0,12,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding Error}"
                           Foreground="#DC2626"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasError}" />

                <Button Grid.Column="1"
                        Content="取消"
                        Click="OnCancel"
                        Padding="18,7"
                        Margin="0,0,8,0" />

                <Button Grid.Column="2"
                        Content="保存并生效"
                        Classes="accent"
                        Click="OnSave"
                        Padding="18,7" />
            </Grid>
        </Border>

        <!-- 设置表单区：Windows 11 Settings 分组卡片风格 -->
        <ScrollViewer>
            <StackPanel Spacing="14" Margin="0,0,10,0">
                <!-- 顶部说明提示条 -->
                <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Location}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="留空的输入框表示「不修改」——密钥框因此可以只填新值。"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- 分组 1：共享密钥 -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="共享密钥"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="三个角色（嵌入/重排/回答）若未单独配置密钥，将默认使用此共享密钥。"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox Text="{Binding ApiKey}"
                                 PasswordChar="●"
                                 PlaceholderText="输入共享 API Key" />
                        <TextBlock Text="{Binding ApiKeyHint}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- 分组 2：嵌入模型配置 -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="嵌入配置"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="决定向量维度与文本切块编码。修改维度后需要重新建库。"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="接入点"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EmbedBaseUrl}" Margin="0,3" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="模型 ID"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EmbedModel}" Margin="0,3" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="维度"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,3">
                                <ComboBox ItemsSource="{Binding AllowedDims}" SelectedItem="{Binding EmbedDim}" Width="140" />
                                <TextBlock Text="⚠ 与向量库现有维度不一致时会被拒绝（换模型要重建库）"
                                           FontSize="12" Foreground="#D97706" VerticalAlignment="Center"
                                           IsVisible="{Binding DimChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBox Text="{Binding EmbedApiKey}"
                                 PasswordChar="●"
                                 PlaceholderText="嵌入专用密钥（留空沿用共享密钥）" />
                        <TextBlock Text="{Binding EmbedApiKeyHint}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- 分组 3：重排模型配置 -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="重排配置"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="用于对初步召回的上下文片段进行二次交叉注意力打分。"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="接入点"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RerankBaseUrl}" Margin="0,3" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="模型 ID"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RerankModel}" Margin="0,3" />
                        </Grid>

                        <TextBox Text="{Binding RerankApiKey}"
                                 PasswordChar="●"
                                 PlaceholderText="重排专用密钥（留空沿用共享密钥）" />
                        <TextBlock Text="{Binding RerankApiKeyHint}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- 分组 4：大模型问答配置 -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="回答模型"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="兼容任意 OpenAI 格式的 Chat 补全端点。"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="接入点"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ChatBaseUrl}" Margin="0,3" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="模型 ID"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ChatModel}" Margin="0,3" />
                        </Grid>

                        <TextBox Text="{Binding ChatApiKey}"
                                 PasswordChar="●"
                                 PlaceholderText="回答专用密钥（留空沿用共享密钥）" />
                        <TextBlock Text="{Binding ChatApiKeyHint}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- 分组 5：检索策略参数 -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="检索策略"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <Grid ColumnDefinitions="70,120,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="召回条数"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RetrieveTopK}" Margin="0,3" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="向量检索初筛候选条数"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center" Margin="10,0" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="送入条数"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ContextN}" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="重排打分后送入大模型的最终片段数"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center" Margin="10,0" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
