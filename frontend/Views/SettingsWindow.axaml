<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:frontend.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="720"
        x:Class="frontend.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="设置" Width="640" Height="720"
        Icon="/Assets/book.ico"
        WindowStartupLocation="CenterOwner"
        TransparencyLevelHint="Mica,AcrylicBlur"
        Background="{DynamicResource RagWhite}">

    <DockPanel Margin="18">
        <!-- 底部操作栏：错误用 InfoBar 内联显示，避免红字被按钮挤到看不见 -->
        <Border DockPanel.Dock="Bottom"
                Margin="0,14,0,0"
                Padding="0,12,0,0"
                BorderBrush="{DynamicResource RagHairline}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <ui:FAInfoBar Grid.Column="0"
                              Title="保存失败"
                              Message="{Binding Error}"
                              Severity="Error"
                              IsOpen="{Binding HasError}"
                              IsClosable="False"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Content="取消"
                        Click="OnCancel"
                        Padding="18,7"
                        Margin="0,0,8,0" />

                <Button Grid.Column="2"
                        Content="保存并生效"
                        Classes="accent"
                        Click="OnSave"
                        Padding="18,7" />
            </Grid>
        </Border>

        <!-- 设置表单：每组用 SettingsExpander，默认展开，保留一眼能看到全部配置的体验 -->
        <ScrollViewer>
            <StackPanel Spacing="10" Margin="0,0,10,0">
                <ui:FAInfoBar Title="配置位置"
                              Message="{Binding Location}"
                              Severity="Informational"
                              IsOpen="True"
                              IsClosable="False" />

                <ui:FASettingsExpander Description="三个角色（嵌入 / 重排 / 回答）若未单独配置密钥，将默认使用此共享密钥。"
                                       IsExpanded="True">
                    <ui:FASettingsExpander.Header>
                        <TextBlock Text="共享密钥" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ui:FASettingsExpander.Header>
                    <ui:FASettingsExpanderItem Content="OpenRouter API Key"
                                               Description="{Binding ApiKeyHint}">
                        <ui:FASettingsExpanderItem.Footer>
                            <TextBox Width="330"
                                     Text="{Binding ApiKey}"
                                     PasswordChar="●"
                                     RevealPassword="False"
                                     PlaceholderText="输入共享 API Key" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Description="决定向量维度与文本切块编码。修改维度后需要重新建库。"
                                       IsExpanded="True">
                    <ui:FASettingsExpander.Header>
                        <TextBlock Text="嵌入配置" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ui:FASettingsExpander.Header>
                    <ui:FASettingsExpanderItem Content="接入点">
                        <ui:FASettingsExpanderItem.Footer>
                            <TextBox Width="330" Text="{Binding EmbedBaseUrl}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="模型 ID">
                        <ui:FASettingsExpanderItem.Footer>
                            <TextBox Width="330" Text="{Binding EmbedModel}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="维度"
                                               Description="256 / 512 / 1024 / 2048；换模型要重建库">
                        <ui:FASettingsExpanderItem.Footer>
                            <StackPanel Width="330" Spacing="4">
                                <ComboBox ItemsSource="{Binding AllowedDims}"
                                          SelectedItem="{Binding EmbedDim}"
                                          Width="140"
                                          HorizontalAlignment="Left" />
                                <TextBlock Text="⚠ 与向量库现有维度不一致时会被拒绝（换模型要重建库）"
                                           FontSize="12"
                                           Foreground="#D97706"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding DimChanged}" />
                            </StackPanel>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="专用密钥"
                                               Description="{Binding EmbedApiKeyHint}">
                        <ui:FASettingsExpanderItem.Footer>
                            <TextBox Width="330"
                                     Text="{Binding EmbedApiKey}"
                                     PasswordChar="●"
                                     RevealPassword="False"
                                     PlaceholderText="嵌入专用密钥（留空沿用共享密钥）" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Description="对初步召回的上下文片段做二次交叉注意力打分。"
                                       IsExpanded="True">
                    <ui:FASettingsExpander.Header>
                        <TextBlock Text="重排配置" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ui:FASettingsExpander.Header>
                    <ui:FASettingsExpanderItem Content="接入点">
                        <ui:FASettingsExpanderItem.Footer>
                            <TextBox Width="330" Text="{Binding RerankBaseUrl}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="模型 ID">
                        <ui:FASettingsExpanderItem.Footer>
                            <TextBox Width="330" Text="{Binding RerankModel}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="专用密钥"
                                               Description="{Binding RerankApiKeyHint}">
                        <ui:FASettingsExpanderItem.Footer>
                            <TextBox Width="330"
                                     Text="{Binding RerankApiKey}"
                                     PasswordChar="●"
                                     RevealPassword="False"
                                     PlaceholderText="重排专用密钥（留空沿用共享密钥）" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Description="兼容任意 OpenAI 格式的 Chat 补全端点。"
                                       IsExpanded="True">
                    <ui:FASettingsExpander.Header>
                        <TextBlock Text="回答模型" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ui:FASettingsExpander.Header>
                    <ui:FASettingsExpanderItem Content="接入点">
                        <ui:FASettingsExpanderItem.Footer>
                            <TextBox Width="330" Text="{Binding ChatBaseUrl}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="模型 ID">
                        <ui:FASettingsExpanderItem.Footer>
                            <TextBox Width="330" Text="{Binding ChatModel}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="专用密钥"
                                               Description="{Binding ChatApiKeyHint}">
                        <ui:FASettingsExpanderItem.Footer>
                            <TextBox Width="330"
                                     Text="{Binding ChatApiKey}"
                                     PasswordChar="●"
                                     RevealPassword="False"
                                     PlaceholderText="回答专用密钥（留空沿用共享密钥）" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Description="控制召回候选与最终送入大模型的片段数量。"
                                       IsExpanded="True">
                    <ui:FASettingsExpander.Header>
                        <TextBlock Text="检索策略" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ui:FASettingsExpander.Header>
                    <ui:FASettingsExpanderItem Content="召回条数"
                                               Description="向量检索初筛候选条数">
                        <ui:FASettingsExpanderItem.Footer>
                            <TextBox Width="120" Text="{Binding RetrieveTopK}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="送入条数"
                                               Description="重排打分后送入大模型的最终片段数">
                        <ui:FASettingsExpanderItem.Footer>
                            <TextBox Width="120" Text="{Binding ContextN}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
